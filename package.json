{
  "name": "tolaria-to-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Builds an offline-capable static website from a Tolaria vault of Markdown notes.",
  "license": "MIT",
  "author": "Eric Jacobsen",
  "repository": {
    "type": "git",
    "url": "https://github.com/erijaco/tolaria-to-website"
  },
  "scripts": {
    "preinstall": "node scripts/verify-pnpm.mjs",
    "site:build": "tsx src/cli.ts build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "12.1.0",
    "fs-extra": "11.4.0",
    "gray-matter": "4.0.3",
    "ignore": "5.3.2",
    "mdast-util-find-and-replace": "3.0.2",
    "prompts": "2.4.2",
    "rehype-highlight": "7.0.2",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.1",
    "@types/prompts": "2.4.9",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
